# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGE_ME_use_a_long_random_string_here
DEBUG=False
ALLOWED_HOSTS=your-api-domain.com
APP_BASE_URL=https://your-api-domain.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_HOST=db
DB_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash-lite
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-CHANGE_ME
SLACK_SIGNING_SECRET=CHANGE_ME
SLACK_CLIENT_ID=CHANGE_ME
SLACK_CLIENT_SECRET=CHANGE_ME
SLACK_OAUTH_REDIRECT_URI=https://your-api-domain.com/api/v1/slack/oauth/callback/

# ── Google OAuth (Gmail + Calendar) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_GMAIL_REDIRECT_URI=https://your-api-domain.com/api/v1/gmail/oauth/callback/
GOOGLE_CALENDAR_REDIRECT_URI=https://your-api-domain.com/api/v1/calendar/oauth/callback/

# ── Zoom ──────────────────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=CHANGE_ME
ZOOM_CLIENT_SECRET=CHANGE_ME
ZOOM_WEBHOOK_SECRET=CHANGE_ME
ZOOM_OAUTH_REDIRECT_URI=https://your-api-domain.com/api/v1/zoom/oauth/callback/

# ── Frontend URL (used in notification emails) ────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
